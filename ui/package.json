{
  "name": "hark-ui",
  "version": "0.1.0",
  "description": "Hark — Electron + Angular 21 UI shell. See ADR-0010.",
  "private": true,
  "author": "Dang Anh Tuan",
  "homepage": "https://github.com/tuanda2912/hark",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "build:renderer": "ng build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "dev:renderer": "ng serve --port 4200",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "wait-on http://localhost:4200 && electron .",
    "dev": "concurrently -k -n ng,tsc,el -c blue,yellow,magenta \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "clean": "rm -rf dist .angular release",
    "build:engine": "cd ../engine && swift build -c release",
    "pack": "npm run build:engine && npm run build && electron-builder --dir",
    "dist": "npm run build:engine && npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/node": "^20.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "@electron/notarize": "^2.5.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.0",
    "wait-on": "^8.0.0"
  }
}
