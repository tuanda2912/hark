# macOS Finder metadata
.DS_Store
**/.DS_Store

# Editor / IDE — personal workspace settings
.vscode/
.idea/
*.swp
*.swo

# Claude Code — per-machine settings (allowlists etc.)
.claude/settings.local.json

# Third-party "taste-skill" design SKILL.md folders, installed via
# `npx skills add leonxlnx/taste-skill ...`. The vendored SKILL.md content is
# kept out of the repo, but skills-lock.json (the manifest) IS committed — so a
# new machine can restore these folders with `npx skills experimental_install`.
# (The project's OWN skills under .claude/skills/ stay tracked.)
.claude/skills/design-taste-frontend/
.claude/skills/redesign-existing-projects/
.claude/skills/high-end-visual-design/

# Swift build outputs (engine/.gitignore covers nested)
.build/

# Temp & system
*.log
*~
